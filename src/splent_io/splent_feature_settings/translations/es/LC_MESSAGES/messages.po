msgid "Settings"
msgstr "Ajustes"

#: src/splent_io/splent_feature_settings/routes.py:77
#, python-format
msgid "%(title)s settings saved."
msgstr "Se han guardado los ajustes de %(title)s."

#: src/splent_io/splent_feature_settings/templates/settings/admin/feature.html:3
#: src/splent_io/splent_feature_settings/templates/settings/admin/feature.html:7
#, python-format
msgid "%(title)s settings"
msgstr "Ajustes de %(title)s"

#: src/splent_io/splent_feature_settings/templates/settings/admin/feature.html:8
msgid "All settings"
msgstr "Todos los ajustes"

#: src/splent_io/splent_feature_settings/templates/settings/admin/feature.html:55
#, python-format
msgid ""
"Currently set by the product configuration (%(env)s). Changing it here "
"overrides that."
msgstr ""
"Este valor viene de la configuración del producto (%(env)s). Si lo cambias "
"aquí, el cambio prevalece."

#: src/splent_io/splent_feature_settings/templates/settings/admin/feature.html:60
msgid "Set here, overriding the product configuration."
msgstr "Establecido aquí, prevalece sobre la configuración del producto."

#: src/splent_io/splent_feature_settings/templates/settings/admin/feature.html:67
msgid ""
"Changes apply immediately. A field left as it is keeps following the "
"product configuration."
msgstr ""
"Los cambios se aplican al momento. Un campo que se deja tal cual sigue "
"tomando el valor de la configuración del producto."

#: src/splent_io/splent_feature_settings/templates/settings/admin/feature.html:68
msgid "Save"
msgstr "Guardar"

#: src/splent_io/splent_feature_settings/templates/settings/admin/index.html:7
msgid "Configure the behaviour of installed features."
msgstr "Configura el comportamiento de las funcionalidades instaladas."

#: src/splent_io/splent_feature_settings/templates/settings/admin/index.html:10
msgid "No configurable features installed."
msgstr "No hay ninguna funcionalidad configurable instalada."
